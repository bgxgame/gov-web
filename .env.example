# 前端应用名称（用于日志前缀）
VITE_APP_NAME=gov-web

# 后端 API 基础路径
VITE_API_BASE_URL=/api

# 接口超时时间（毫秒）
VITE_API_TIMEOUT=10000

# 前端控制台日志级别：debug / info / warn / error
VITE_APP_LOG_LEVEL=warn

# 是否把 npm run dev / npm run build 输出写入日志文件（true/false）
VITE_APP_ENABLE_FILE_LOG=true

# 日志目录（相对项目根目录）
VITE_APP_LOG_DIR=logs
